        <name>Block Edit e New</name>
        <order/>
        <script><![CDATA[function onLoad() {
  // verifica pela label "Completed" (mais seguro se você não souber o value)
  if (g_form.getDisplayValue('state') !== 'Completed') return;

  // função que tenta esconder os botões
  function hideRelatedListButtons() {
    var selectors = [
      '.related-list-container .list-edit',
      '.related-list-container .list-new',
      '.related-list .list-edit',
      '.related-list .list-new',
      '.related-list-actions .list-edit',
      '.related-list-actions .list-new'
    ];
    var elems = document.querySelectorAll(selectors.join(','));
    elems.forEach(function(el) { el.style.display = 'none'; });
  }

  // tenta imediatamente
  hideRelatedListButtons();

  // observa mudanças no DOM (para quando related lists carregarem depois)
  var target = document.querySelector('div#related_lists') || document.body;
  var mo = new MutationObserver(function() { hideRelatedListButtons(); });
  mo.observe(target, { childList: true, subtree: true });
}
]]></script>
