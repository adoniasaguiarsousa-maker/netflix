        <script><![CDATA[// este script roda no carregamento do formulário porque a UI Action é client-side
(function() {
    // roda só quando o formulário carregar
    if (g_form.getDisplayValue('state') === 'Completed') {
        function hideButtons() {
            var elems = document.querySelectorAll(
                '.related-list-container .list-edit, .related-list-container .list-new'
            );
            elems.forEach(function(el) {
                el.style.display = 'none';
            });
        }

        // tenta esconder de imediato
        hideButtons();

        // observa o DOM caso as listas carreguem depois
        var target = document.querySelector('#related_lists') || document.body;
        var mo = new MutationObserver(hideButtons);
        mo.observe(target, { childList: true, subtree: true });
    }
})();
]]></script>
