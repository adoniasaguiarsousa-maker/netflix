        <messages/>
        <name>Block edit e new</name>
        <order/>
        <script><![CDATA[(function onLoad() {
    // Pega o valor interno do campo State
    var state = g_form.getValue('state'); 

    // Se o estado for Completed (valor interno = 3)
    if (state == '3') { 
        // Lista de related lists que queremos bloquear
        var relatedLists = ['actors', 'directors']; 

        relatedLists.forEach(function(rlName) {
            var rl = g_form.getRelatedList(rlName);
            if (rl) {
                rl.setCanAdd(false);   // esconde botão "New"
                rl.setCanEdit(false);  // esconde botão "Edit"
            }
        });
    }
})();
]]></script>
